          <mxGeometry x="460" y="110" width="320" height="230" as="geometry" />
        </mxCell>
        <mxCell id="ext_1" value="&lt;b&gt;Production Microservices&lt;/b&gt;&lt;br&gt;Payment, Order, Auth, Catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#6B21A8;fontColor=#F3E8FF;fontSize=11;" vertex="1" parent="box_ext">
