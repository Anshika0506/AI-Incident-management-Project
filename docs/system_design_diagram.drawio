          <mxGeometry x="25" y="490" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe_8" value="&lt;b&gt;IncidentTimeline Component&lt;/b&gt;&lt;br&gt;Chronological Event Audit Trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#475569;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_fe">
          <mxGeometry x="25" y="560" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe_9" value="&lt;b&gt;1-Click Outage Simulator Modal&lt;/b&gt;&lt;br&gt;HikariCP, Redis Split-Brain, Kafka Lag Presets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451A03;strokeColor=#F59E0B;fontColor=#FEF3C7;fontSize=11;" vertex="1" parent="box_fe">
          <mxGeometry x="25" y="630" width="310" height="50" as="geometry" />
