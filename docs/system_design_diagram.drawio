          <mxGeometry x="20" y="105" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ext_3" value="&lt;b&gt;HTTP POST /api/v1/logs&lt;/b&gt;&lt;br&gt;Payload: incidentId, level, service, message, stackTrace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581C87;strokeColor=#E9D5FF;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="box_ext">
          <mxGeometry x="20" y="165" width="280" height="45" as="geometry" />
        </mxCell>

        <!-- CONTAINER 3: SPRING BOOT 3.2 BACKEND (PORT 8080) -->
        <mxCell id="box_be" value="ENTERPRISE BACKEND ARCHITECTURE (Spring Boot 3.2.5 + Java 22) [Port 8080]" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#818CF8;fontColor=#818CF8;fontStyle=1;fontSize=14;rounded=1;arcSize=6;startSize=35;" vertex="1" parent="1">
          <mxGeometry x="840" y="110" width="460" height="880" as="geometry" />
        </mxCell>

        <!-- Security Boundary -->
        <mxCell id="be_sec" value="&lt;b&gt;1. Security Filter Chain (SecurityConfig.java)&lt;/b&gt;&lt;br&gt;• Stateless Session (SessionCreationPolicy.STATELESS)&lt;br&gt;• AuthTokenFilter (OncePerRequestFilter - JWT Bearer extraction)&lt;br&gt;• BCryptPasswordEncoder (cost 10) &amp;amp; CorsConfigurationSource" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E1B4B;strokeColor=#6366F1;fontColor=#E0E7FF;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_be">
          <mxGeometry x="25" y="50" width="410" height="75" as="geometry" />
        </mxCell>

        <!-- Controller Layer -->
        <mxCell id="be_ctrl" value="&lt;b&gt;2. Controller REST API Layer (@RestController, @Validated)&lt;/b&gt;&lt;br&gt;• IncidentController: /api/v1/incidents (CRUD, /status, /analyze)&lt;br&gt;• LogController: /api/v1/logs (Ingest &amp;amp; /incident/{id})&lt;br&gt;• AuthController: /api/auth (Login &amp;amp; Register)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#475569;fontColor=#F8FAFC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_be">
          <mxGeometry x="25" y="145" width="410" height="75" as="geometry" />
        </mxCell>

        <!-- Service Layer -->
        <mxCell id="be_svc" value="&lt;b&gt;3. Core Service Layer (@Service)&lt;/b&gt;&lt;br&gt;• IncidentServiceImpl: Business Logic, State Workflow &amp;amp; DTO Mapping&lt;br&gt;• LogServiceImpl: Foreign Key Verification &amp;amp; Chronological Queries&lt;br&gt;• AIServiceImpl: RAG Prompt Assembler &amp;amp; Gemini RestClient Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#475569;fontColor=#F8FAFC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_be">
          <mxGeometry x="25" y="240" width="410" height="75" as="geometry" />
        </mxCell>

        <!-- Cache Layer -->
        <mxCell id="be_cache" value="&lt;b&gt;4. Cache-Aside Acceleration Layer (@EnableCaching)&lt;/b&gt;&lt;br&gt;• @Cacheable(value = &quot;incidentAnalysis&quot;, key = &quot;#id&quot;)&lt;br&gt;• Cache Miss: Queries DB, calls Gemini AI (~3.5s), populates cache&lt;br&gt;• Cache Hit: Instant in-memory RAM / Redis return in &amp;lt; 5 milliseconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451A03;strokeColor=#F59E0B;fontColor=#FEF3C7;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_be">
          <mxGeometry x="25" y="335" width="410" height="75" as="geometry" />
        </mxCell>

        <!-- RAG Engine Details -->
        <mxCell id="be_rag" value="&lt;b&gt;5. RAG Intelligence Pipeline (AIServiceImpl.java)&lt;/b&gt;&lt;br&gt;• Context Retrieval: Pulls associated incident logs &amp;amp; stack traces&lt;br&gt;• Prompt Augmentation: Structured SRE system prompt template&lt;br&gt;• RestClient Request: Low temperature (0.2) to eliminate hallucinations&lt;br&gt;• Structured JSON Extraction: rootCause, confidenceScore, suggestedPlaybook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#022C22;strokeColor=#10B981;fontColor=#D1FAE5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_be">
          <mxGeometry x="25" y="430" width="410" height="90" as="geometry" />
        </mxCell>

        <!-- Repository Layer -->
        <mxCell id="be_repo" value="&lt;b&gt;6. Repository Layer (Spring Data JPA / Hibernate)&lt;/b&gt;&lt;br&gt;• IncidentRepository extends JpaRepository&amp;lt;Incident, Long&amp;gt;&lt;br&gt;• LogRepository: findByIncidentIdOrderByTimestampDesc(id)&lt;br&gt;• UserRepository: findByUsername(username)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#475569;fontColor=#F8FAFC;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_be">
          <mxGeometry x="25" y="540" width="410" height="75" as="geometry" />
        </mxCell>

        <!-- Connection Pool -->
        <mxCell id="be_hikari" value="&lt;b&gt;7. HikariCP High-Performance JDBC Connection Pool&lt;/b&gt;&lt;br&gt;Maintains reusable connection threads to prevent DB exhaustion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#3B82F6;fontColor=#DBEAFE;fontSize=11;" vertex="1" parent="box_be">
          <mxGeometry x="25" y="635" width="410" height="50" as="geometry" />
        </mxCell>

        <!-- Fault Tolerance -->
        <mxCell id="be_deg" value="&lt;b&gt;8. Graceful Degradation &amp;amp; Resilience Boundary&lt;/b&gt;&lt;br&gt;try-catch fallback catches 429 quota / 503 errors with zero 500 crashes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F1D38;strokeColor=#EC4899;fontColor=#FCE7F3;fontSize=11;" vertex="1" parent="box_be">
          <mxGeometry x="25" y="705" width="410" height="50" as="geometry" />
        </mxCell>

        <!-- DTO Decoupling -->
        <mxCell id="be_dto" value="&lt;b&gt;9. DTO Network Contract Validation Layer&lt;/b&gt;&lt;br&gt;CreateIncidentRequest, IngestLogRequest, AnalysisResponse, JwtResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#475569;fontColor=#F8FAFC;fontSize=11;" vertex="1" parent="box_be">
          <mxGeometry x="25" y="775" width="410" height="50" as="geometry" />
        </mxCell>

        <!-- CONTAINER 4: PERSISTENCE & AI CLOUD -->
        <mxCell id="box_data" value="PERSISTENCE &amp; CLOUD AI SERVICES" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#34D399;fontColor=#6EE7B7;fontStyle=1;fontSize=13;rounded=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="1360" y="110" width="250" height="880" as="geometry" />
        </mxCell>

        <mxCell id="db_h2" value="&lt;b&gt;H2 In-Memory DB&lt;/b&gt;&lt;br&gt;Development &amp;amp; Viva Mode&lt;br&gt;(jdbc:h2:mem:incidentdb)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#064E3B;strokeColor=#10B981;fontColor=#ECFDF5;fontSize=11;" vertex="1" parent="box_data">
          <mxGeometry x="30" y="55" width="190" height="95" as="geometry" />
        </mxCell>

        <mxCell id="db_mysql" value="&lt;b&gt;MySQL 8.0 / Postgres&lt;/b&gt;&lt;br&gt;Production Target DB&lt;br&gt;Full ACID Transactions" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1E3A8A;strokeColor=#60A5FA;fontColor=#EFF6FF;fontSize=11;" vertex="1" parent="box_data">
          <mxGeometry x="30" y="180" width="190" height="95" as="geometry" />
        </mxCell>

        <mxCell id="cache_redis" value="&lt;b&gt;Redis RAM Cache&lt;/b&gt;&lt;br&gt;Sub-5ms Query Speed&lt;br&gt;100% LLM Cost Saved" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#78350F;strokeColor=#F59E0B;fontColor=#FFFBEB;fontSize=11;" vertex="1" parent="box_data">
          <mxGeometry x="30" y="305" width="190" height="95" as="geometry" />
        </mxCell>

        <mxCell id="cloud_gemini" value="&lt;b&gt;Google Gemini 3.5 Flash&lt;/b&gt;&lt;br&gt;Cloud Generative AI API&lt;br&gt;&lt;i&gt;gemini-3.5-flash:generateContent&lt;/i&gt;&lt;br&gt;• Temp: 0.2 (Deterministic)&lt;br&gt;• Structured JSON Schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#831843;strokeColor=#F43F5E;fontColor=#FFF1F2;fontSize=11;" vertex="1" parent="box_data">
          <mxGeometry x="30" y="440" width="190" height="110" as="geometry" />
        </mxCell>

        <mxCell id="table_inc" value="&lt;b&gt;Table: incidents&lt;/b&gt;&lt;br&gt;id (PK), title, description, severity, status, root_cause, playbook, confidence_score, timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#475569;fontColor=#CBD5E1;fontSize=10;" vertex="1" parent="box_data">
          <mxGeometry x="25" y="585" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="table_logs" value="&lt;b&gt;Table: log_entries&lt;/b&gt;&lt;br&gt;id (PK), incident_id (FK), log_level, source_service, message, stack_trace, timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#475569;fontColor=#CBD5E1;fontSize=10;" vertex="1" parent="box_data">
          <mxGeometry x="25" y="675" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="table_users" value="&lt;b&gt;Table: users&lt;/b&gt;&lt;br&gt;id (PK), username (UK), email (UK), password (BCrypt), role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#475569;fontColor=#CBD5E1;fontSize=10;" vertex="1" parent="box_data">
          <mxGeometry x="25" y="765" width="200" height="60" as="geometry" />
